# ============================================================
# Ejemplo de variables de conexión y autenticación - Airflow + PostgreSQL + dbt
# Copiar a `.env` y ajustar valores:  cp .env.example .env
# `.env` está commiteado a propósito (proyecto de curso con valores locales).
# ============================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=airflow
POSTGRES_PASSWORD=cambiar_password
POSTGRES_DB=airflow
POSTGRES_PORT=5432
# DB warehouse (datos del negocio, separada de la metadata de Airflow).
POSTGRES_WAREHOUSE_DB=sgfood

# ---------- Airflow: imagen y usuario ----------
# AIRFLOW_UID = `id -u` del host (archivos en volúmenes con tu usuario).
# Se aplica en runtime (sin rebuild); única variable dependiente de la máquina.
AIRFLOW_IMAGE_NAME=apache/airflow:2.10.5-python3.11
AIRFLOW_UID=1000
AIRFLOW_GID=0

# ---------- Airflow: ejecutor y webserver ----------
AIRFLOW_EXECUTOR=LocalExecutor
AIRFLOW_WEBSERVER_PORT=8080

# ---------- Airflow: seguridad ----------
# Generar con: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=cambiar_fernet_key
# Generar con: python3 -c "import secrets; print(secrets.token_hex(16))"
AIRFLOW_WEBSERVER_SECRET_KEY=cambiar_secret_key

# ---------- Airflow: usuario admin (autenticación UI) ----------
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=cambiar_password
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=User
AIRFLOW_ADMIN_EMAIL=admin@example.com

# ---------- Airflow: comportamiento ----------
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=True
AIRFLOW__CORE__LOAD_DEFAULT_CONNECTIONS=False

# ---------- SG-Food: schedule del DAG principal (parametrizable) ----------
SGFOOD_SCHEDULE=@daily

# ---------- dbt ----------
# dbt se autentica con POSTGRES_USER/POSTGRES_PASSWORD contra el warehouse.
DBT_IMAGE_NAME=ghcr.io/dbt-labs/dbt-postgres:1.9.latest
DBT_HOST=postgres
DBT_PORT=5432
DBT_SCHEMA=analytics
DBT_THREADS=4

# Zona horaria (America/Guatemala = UTC-6 sin DST)
TZ=America/Guatemala
